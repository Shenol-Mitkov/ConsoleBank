namespace ConsoleBank
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("Välkommen till ConsoleBank TM");
            Console.WriteLine("Välj ditt konto och skriv in ditt lösenord ");
            Console.WriteLine();


            string[] users = UserProfiles();
            var accounts = InitializeAccounts(users);

            // Outer loop: allow multiple users to log in sequentially
            while (true)
            {
                Console.WriteLine("Välj ett konto genom att trycka nummer 1-{0}:", users.Length);
                for (int i = 0; i < users.Length; i++)
                {
                    Console.WriteLine($"{i + 1}. {users[i]}");
                }

                var keyInfo = Console.ReadKey(true);
                char pressed = keyInfo.KeyChar;
                int index = -1;
                if (pressed >= '1' && pressed <= (char)('0' + users.Length))
                {
                    index = pressed - '1';
                }

                if (index < 0)
                {
                    Console.WriteLine("\nOgiltigt val. Försök igen.");
                    Console.WriteLine();
                    continue;
                }

                bool authenticated = PasswordCheck(users[index], 3);
                if (!authenticated)
                {
                    Console.WriteLine("Stänger programmet pga för många misslyckade försök.");
                    Environment.Exit(0);
                }
                Console.Clear();

                Console.WriteLine($"Åtkomst godkänd. Välkommen, {users[index]}!");
                Console.WriteLine(" ");

                bool loggedIn = true;
                while (loggedIn)
                {
                    Console.WriteLine("Välj alternativ: ");
                    Console.WriteLine("1. Se dina konton och saldo");
                    Console.WriteLine("2. Överföring mellan konton");
                    Console.WriteLine("3. Ta ut pengar");
                    Console.WriteLine("4. logga ut");

                    var menuKey = Console.ReadKey(true).KeyChar;
                    switch (menuKey)
                    {
                        case '1':
                            ShowAccounts(users[index], accounts);
                            break;
                        case '2':
                            TransferBetweenAccounts(users[index], accounts);
                            break;
                        case '3':
                            Console.WriteLine("Val 3 är inte implementerat än.");
                            break;
                        case '4':
                            Console.WriteLine("Du loggas ut...");
                            loggedIn = false;
                            break;
                        default:
                            Console.WriteLine($"Val '{menuKey}' är inte giltigt.");
                            break;
                    }

                    Console.WriteLine();
                }

                Console.Clear();
                // loop back to allow another user to log in
            }
        }

        // Simple account model
        private class Account
        {
            public string AccountNumber { get; set; } = string.Empty;
            public decimal Balance { get; set; }
            public string Type { get; set; } = "Check";
        }

        // Create a different number of accounts per user with sample balances
        // Each user will have at least one account and users will have unique counts
        static System.Collections.Generic.Dictionary<string, System.Collections.Generic.List<Account>> InitializeAccounts(string[] users)
        {
            var dict = new System.Collections.Generic.Dictionary<string, System.Collections.Generic.List<Account>>();

            // Predefined account types to assign names to accounts
            var accountTypes = new[] { "Lönekonto", "Sparkonto", "Buffertkonto", "Resekonto", "Investeringskonto" };

            for (int i = 0; i < users.Length; i++)
            {
                var list = new System.Collections.Generic.List<Account>();

                // Give each user a unique number of accounts (1, 2, 3, ...)
                int accountCount = i + 1;
                for (int a = 0; a < accountCount; a++)
                {
                    string acctNum = $"{i + 1}-{(a + 1):00}";

                    // Assign a sample balance (varying amounts including ören)
                    decimal balance = (1000m * (a + 1)) + (50m * i) + (0.25m * a);

                    // Pick an account type name from the list (wrap if needed)
                    string type = accountTypes[a % accountTypes.Length];

                    list.Add(new Account { AccountNumber = acctNum, Balance = balance, Type = type });
                }

                dict[users[i]] = list;
            }

            return dict;
        }
        // Show all accounts for the given user
        static void ShowAccounts(string user, System.Collections.Generic.Dictionary<string, System.Collections.Generic.List<Account>> accounts)
        {
            Console.WriteLine($"\nKonton för {user}:");
            if (!accounts.TryGetValue(user, out var list) || list.Count == 0)
            {
                Console.WriteLine("Inga konton hittades för användaren.");
                return;
            }

            for (int i = 0; i < list.Count; i++)
            {
                var a = list[i];
                Console.WriteLine($"{i + 1}. {a.Type} - Saldo: {a.Balance:C}");
            }

            Console.WriteLine("\nTryck valfri tangent för att återgå till menyn...");
            Console.ReadKey(true);
        }

        static string[] UserProfiles()
        {
            string[] users = new string[5];
            users[0] = "Shenol Mitkov";
            users[1] = "Bertil Korggren";
            users[2] = "Felix Reztsel";
            users[3] = "Alexandra Nilsson";
            users[4] = "Anas Alhussein";

            return users;
        }

        
        static bool PasswordCheck(string user, int maxAttempts)
        {
            for (int attempt = 1; attempt <= maxAttempts; attempt++)
            {
                Console.Write($"\nSkriv in lösenord för {user}: ");
                string password = Console.ReadLine() ?? string.Empty;
                if (password == "Admin")
                    return true;

                int remaining = maxAttempts - attempt;
                if (remaining > 0)
                    Console.WriteLine($"Fel lösenord. Försök igen. ({remaining} försök kvar)");
            }
           
            return false;
        }

       


    }
}
